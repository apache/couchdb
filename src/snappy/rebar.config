{plugins, [
    pc
]}.

{project_plugins, [
    erlfmt
]}.

{provider_hooks, [
    {pre, [
        {compile, {pc, compile}},
        {clean, {pc, clean}}
    ]}
]}.

{port_specs, [
    {"priv/snappy_nif.so", ["c_src/*.cc", "c_src/snappy/*.cc"]}
]}.

% rebar adds no optimization flag of its own. Keep the -O flags: snappy built
% without optimization is several times slower.
{port_env, [
    % Development compilation
    % {".*", "CXXFLAGS", "$CXXFLAGS -g -Wall -fPIC -std=c++11 -DHAVE_CONFIG_H=1"}

    % Production compilation
    {"(linux|solaris|darwin|freebsd|netbsd|openbsd|dragonfly)", "CXXFLAGS",
        "$CXXFLAGS -Wall -std=c++11 -DNDEBUG -DHAVE_CONFIG_H=1 -O3 -fvisibility=hidden"},
    {"(linux|solaris|darwin|freebsd|netbsd|openbsd|dragonfly)", "LDFLAGS", "$LDFLAGS -lstdc++"},
    {"win32", "CXXFLAGS", "$CXXFLAGS /O2 /DNDEBUG /DHAVE_CONFIG_H=1"}
]}.

{eunit_opts, [
    debug_info,
    verbose
]}.
